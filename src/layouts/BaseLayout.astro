---
import '../styles/global.css';
import '../styles/site.css';
import { Font } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import SocialPreviewMetadata from '../components/SocialPreviewMetadata.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CONTACT_EMAIL, DISCORD_URL, NAV, SITE_URL } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD objects for this page (e.g. an Event). */
  jsonLd?: Record<string, unknown>[];
}

const DEFAULT_DESCRIPTION =
  'Purdue Hackers is a community of Purdue students building creative projects across software, hardware, design and art. Hack Night is every Friday at 8 PM in the HIVE.';

const {
  title = 'Purdue Hackers',
  description = DEFAULT_DESCRIPTION,
  jsonLd = [],
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, SITE_URL).href;
const current = NAV.find((item) => item.href === path);
const fullTitle = path === '/' ? title : `${title} · Purdue Hackers`;

const structuredData: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Purdue Hackers',
    url: SITE_URL,
    logo: `${SITE_URL}/glider.svg`,
    email: CONTACT_EMAIL,
    foundingDate: '2013',
    description: DEFAULT_DESCRIPTION,
    sameAs: [
      'https://github.com/purduehackers',
      'https://www.instagram.com/purduehackers/',
      'https://www.linkedin.com/company/purdue-hackers/',
      'https://x.com/purduehackers/',
      'https://www.youtube.com/@PurdueHackers/',
    ],
  },
  ...(path === '/'
    ? []
    : [
        {
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: [
            {
              '@type': 'ListItem',
              position: 1,
              name: 'Purdue Hackers',
              item: SITE_URL,
            },
            { '@type': 'ListItem', position: 2, name: title, item: canonical },
          ],
        },
      ]),
  ...jsonLd,
];
---

<html lang="en">
  <head>
    <script
      defer
      src="https://umami.purduehackers.com/script.js"
      data-website-id="6b1a85c2-a54b-44ef-82c5-3c8ae34d8ec5"></script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/glider.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <SocialPreviewMetadata
      title={fullTitle}
      description={description}
      url={canonical}
    />
    {
      structuredData.map((data) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(data).replace(/</g, '\\u003c')}
        />
      ))
    }
    <slot name="head" />

    <Font cssVariable="--font-whyte" preload />
    <Font cssVariable="--font-inconsolata" preload />
    <Font cssVariable="--font-silkscreen" preload />
    <Font cssVariable="--font-pixel-hackers" preload />
    <Font cssVariable="--font-polysans" preload />

    <Analytics />

    <style is:global>
      .header-over-dark .nav-link {
        color: var(--color-bg) !important;
      }
      .header-over-dark .header-glider {
        color: var(--color-bg);
      }
      body.menu-open .header-glider {
        color: var(--color-bg);
      }
      .header-over-dark .nav-link:hover {
        background: var(--color-bg) !important;
        color: #7d3bff !important;
      }
      .header-over-dark .mobile-menu-btn__line {
        background-color: var(--color-bg);
      }
    </style>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header
      id="site-header"
      class="fixed top-0 left-0 right-0 z-30 px-6 py-5 md:px-8 md:py-6 font-inconsolata"
    >
      <div class="flex items-center justify-between">
        <!-- glider logo -->
        <a
          href="/"
          class="header-glider text-black inline-flex items-center transition-opacity hover:opacity-70"
          aria-label="Purdue Hackers home"
        >
          <svg
            class="h-8 w-8"
            viewBox="0 0 1815 1816"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M723.58 1458.25H357.555V1092.02H723.58V1458.25ZM1089.6 725.795H1455.63V1458.25H1089.6V1092.02H723.58V359.568H1089.6V725.795Z"
            ></path>
          </svg>
        </a>

        <!-- desktop nav -->
        <nav
          class="hidden lg:flex items-center gap-3 xl:gap-6 header-links"
          aria-label="Main"
        >
          {
            NAV.map((item) => (
              <a
                href={item.href}
                aria-current={current === item ? 'page' : undefined}
                class="nav-link text-base text-black tracking-wide font-semibold uppercase"
              >
                {item.label}
              </a>
            ))
          }
          <a href={DISCORD_URL} target="_blank" class="nav-cta">
            Join Discord <span aria-hidden="true">↗</span>
          </a>
        </nav>

        <!-- mobile hamburger -->
        <button
          type="button"
          id="menu-toggle"
          class="mobile-menu-btn lg:hidden ml-auto flex flex-col justify-center items-center w-10 h-10 gap-1.5 text-black focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-black"
          aria-expanded="false"
          aria-label="Open menu"
          aria-controls="mobile-menu"
        >
          <span class="mobile-menu-btn__line" aria-hidden="true"></span>
          <span class="mobile-menu-btn__line" aria-hidden="true"></span>
          <span class="mobile-menu-btn__line" aria-hidden="true"></span>
        </button>
      </div>
    </header>
    <!-- mobile menu overlay -->
    <div
      id="mobile-menu"
      class="mobile-menu fixed inset-0 z-20 bg-black font-inconsolata overflow-y-auto"
      aria-hidden="true"
      role="dialog"
      aria-label="Main menu"
      inert
    >
      <nav
        class="mobile-menu__nav flex flex-col justify-center min-h-full px-8 pt-24 pb-10"
        aria-label="Main"
      >
        {
          NAV.map((item, index) => (
            <a
              href={item.href}
              aria-current={current === item ? 'page' : undefined}
              class="mobile-menu__link mobile-menu__link--page"
              style={`--i: ${index}`}
            >
              <span class="mobile-menu__index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span>
                {item.label}
                <small>{item.blurb}</small>
              </span>
            </a>
          ))
        }
        <a
          href={DISCORD_URL}
          target="_blank"
          class="mobile-menu__link mobile-menu__discord"
        >
          Join Discord ↗
        </a>
      </nav>
    </div>
    <slot />
    <SiteFooter />
    <script src="../scripts/header.ts"></script>
    <!-- <script src="../scripts/hoverSound.ts"></script> -->
  </body>
</html>
