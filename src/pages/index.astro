---
import BaseLayout from '../layouts/BaseLayout.astro';
import Glider from '../components/GliderShader.astro';
import { getPixelIndices } from '../utils/dither';
import LogoGrid from '../components/LogoSoup';
import sponsorLogos from '../data/sponsors.normalized.json';
import PhotoCollageItems from '../components/PhotoCollageItems.astro';
import HackNightPhotos from '../components/HackNightPhotos.astro';
import Community from '../components/Community.astro';
import { getLatestShip } from '../lib/ships';
import { getLatestPost } from '../lib/blog';
import Sprite from '../components/Sprite.astro';
import DitherFilters from '../components/DitherFilters.astro';
import { DITHER_BAND_ROWS, GLIDER_CELL_SIZE } from '../constants/gliderGrid';

// The sim's last rows are the dithered transition; the hero has to reserve
// that much room under its content so the ramp never runs into the CTA.
const ditherBandPx = DITHER_BAND_ROWS * GLIDER_CELL_SIZE;

const [latestShip, latestPost] = await Promise.all([
  getLatestShip(),
  getLatestPost(),
]);

const buildPixels = getPixelIndices(50);
const backPixels = getPixelIndices(40);
const shouldEnablePixelCursor = true;
---

<BaseLayout
  title="Purdue Hackers"
  description="Purdue Hackers backs highly talented and curious individuals working on ambitious ideas across software, hardware, and design. Hack Night is every Friday at 8 PM in the HIVE at Purdue."
>
  {
    shouldEnablePixelCursor && (
      <div
        id="pixel-trail-container"
        style="position: fixed; inset: 0; z-index: 10; pointer-events: none; overflow: hidden;"
      />
    )
  }
  <main id="main">
    <DitherFilters />
    <!-- one Conway grid spans the whole hero: the gun runs at the top, and the
         bottom rows are the pinned dither that fades into the dark section.
         Click and drag anywhere on it to draw cells (see gliderShader.ts). -->
    <section
      class="relative z-[2] isolate flex items-start md:items-start gap-16 px-4 pt-64 sm:px-10 md:px-40 md:pt-50 overflow-hidden [@media(pointer:fine)]:cursor-crosshair [@media(pointer:fine)]:select-none"
      style={`background-color: var(--color-bg); padding-bottom: calc(${ditherBandPx}px + 2rem);`}
    >
      <div class="hero-grid" aria-hidden="true"></div>
      <Glider
        cellSize={GLIDER_CELL_SIZE}
        speedMs={100}
        ditherRows={DITHER_BAND_ROWS}
      />
      <div class="relative z-10 flex flex-col gap-6">
        <h1
          class="font-pixel-hackers text-7xl sm:text-8xl md:text-[8.5rem] leading-[0.85] shrink-0 noselect pb-2"
        >
          Purdue<br />Hackers
        </h1>
        <p
          class="max-w-[36rem] font-inconsolata uppercase sm:text-lg md:text-xl font-semibold leading-relaxed mb-6"
        >
          We back highly talented and curious individuals working on ambitious
          ideas across
          <span class="text-[var(--color-accent-2)]">software</span>,
          <span class="text-[var(--color-primary)]">hardware</span>, and
          <span class="text-[var(--color-accent)]">design</span>.
        </p>
        <a
          href="https://events.purduehackers.com/"
          target="_blank"
          class="join-session-btn"
          style="--pixel-cols: 10; --pixel-color: var(--color-primary);"
        >
          <span class="join-session-btn__pixels" aria-hidden="true">
            {
              buildPixels.map((delayIndex) => (
                <span
                  class="join-session-btn__pixel"
                  style={`--i: ${delayIndex}`}
                />
              ))
            }
          </span>
          <span class="join-session-btn__label pointer-events-none"
            >build with us</span
          >
        </a>
      </div>
    </section>
    <!-- photo collage: desktop only — between dither and dark section -->
    <div
      data-header-dark
      class="photo-collage photo-collage--desktop relative z-[3] hidden overflow-visible bg-black md:block"
    >
      <PhotoCollageItems ship={latestShip} post={latestPost} />
    </div>
    <div class="photo-caption" id="photo-caption">
      <p class="photo-caption__title"></p>
      <p class="photo-caption__desc"></p>
    </div>

    <section
      data-header-dark
      class="photo-collage-after relative z-[2] min-h-screen flex flex-col items-center px-8 pb-16 bg-black text-[var(--color-bg)] text-center overflow-clip"
    >
      <!-- creatura! -->
      <div
        class="absolute top-110 md:top-135 lg:top-150 right-10 md:right-22 lg:right-48 scale-90 sm:scale-[1] md:scale-[1.35] lg:scale-[1.65]"
      >
        <Sprite
          id="angry-guy-sprite"
          className=""
          backgroundImage="/sprites/angry_dude_sprite_pink.png"
          spriteSize={224}
          numRows={1}
          numCols={2}
          numFrames={2}
          duration={1.5}
        />
      </div>
      <div
        class="absolute -left-8 md:left-24 lg:left-32 top-1/3 md:top-1/2 lg:top-1/2 -translate-y-1/2 scale-[2] sm:scale-[2] md:scale-[2.8] lg:scale-[3.5] 2xl:scale-300 rotate-[-10deg]"
      >
        <Sprite
          id="fish-with-legs-sprite"
          className=""
          backgroundImage="/sprites/fish_with_legs_sprite_indigo.png"
          spriteSize={124}
          numRows={1}
          numCols={2}
          numFrames={2}
          duration={1.5}
        />
      </div>
      <img
        src="/lizard_gun.png"
        alt=""
        width="470"
        height="516"
        loading="lazy"
        decoding="async"
        class="absolute image-rendering-pixelated bottom-1/3 md:bottom-24 lg:bottom-24 -right-12 md:right-10 lg:right-14 w-40 h-auto md:w-56 lg:w-72 object-contain pointer-events-none"
        aria-hidden="true"
      />

      <!-- 1 -->
      <div class="mb-72 relative">
        <img
          src="/ph.svg"
          alt="Purdue Hackers"
          width="32"
          height="32"
          loading="lazy"
          decoding="async"
          class="w-8 h-8 mb-6 mx-auto fill-[var(--color-secondary)]"
        />
        <p
          class="max-w-[36rem] font-inconsolata text-l md:text-xl uppercase font-semibold leading-relaxed mt-6"
        >
          Making something you're proud of is incredibly rewarding. But it's
          really hard to do alone. Since 2013, Purdue Hackers has been a home to
          build, ship, and demo creative-technical projects together. <br />
          <br /> Here's how we do it:
        </p>
      </div>

      <!-- 2 -->
      <div
        id="hack-night"
        class="mb-72 relative w-full max-w-[32rem] scroll-mt-24"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="w-8 h-8 mx-auto text-[var(--color-secondary)]"
          fill="currentColor"
        >
          <polygon
            points="22 17 22 19 21 19 21 20 20 20 20 21 18 21 18 22 16 22 16 23 10 23 10 22 8 22 8 21 6 21 6 20 5 20 5 19 4 19 4 17 3 17 3 15 2 15 2 9 3 9 3 7 4 7 4 5 5 5 5 4 6 4 6 3 8 3 8 2 10 2 10 1 15 1 15 2 13 2 13 3 11 3 11 4 10 4 10 6 9 6 9 8 8 8 8 12 9 12 9 14 10 14 10 16 11 16 11 17 13 17 13 18 15 18 15 19 19 19 19 18 21 18 21 17 22 17"
          ></polygon>
        </svg>
        <h2
          class="max-w-[32rem] font-pixel-hackers text-4xl md:text-6xl leading-relaxed pb-6 pt-6"
        >
          Hack Night
        </h2>
        <p class="max-w-[32rem] font-polysans text-l leading-relaxed">
          Hack Night happens <span class="highlight">every Friday, 8pm</span> at <a
            href="https://engineering.purdue.edu/HIVE"
            target="_blank"
            class="highlight hover:text-[var(--color-secondary)] underline transition-colors duration-300 motion-reduce:transition-none whitespace-nowrap"
            >the HIVE (BHEE 270/280)</a
          >. It's a dedicated space to work on personal projects, join (or run)
          workshops, and share your progress at Checkpoints or on <a
            href="https://discord.gg/5paFjKzdPE"
            target="_blank"
            class="highlight hover:text-[var(--color-secondary)] underline transition-colors duration-300 motion-reduce:transition-none"
            >Discord</a
          >. Ends when the last person leaves (often until 6am or later).
        </p>
        <HackNightPhotos />
        <p class="max-w-[32rem] pt-6 font-polysans text-l leading-relaxed">
          If you go to Purdue &mdash; whether you've never written code before
          or are highly technical, whether you're an art major or a CS major
          &mdash; <br />
          <span class="highlight">you're invited.</span>
        </p>
        <p class="pt-6">
          <a
            href="/hack-night"
            class="font-inconsolata text-l md:text-xl font-semibold uppercase underline hover:text-[var(--color-secondary)] transition-colors duration-300 motion-reduce:transition-none"
            >Next date, directions + what a night is like →</a
          >
        </p>
      </div>

      <Community />

      <!-- 4 -->
      <div class="mb-72 relative">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="w-8 h-8 mx-auto text-[var(--color-secondary)]"
          fill="currentColor"
        >
          <polygon
            points="23 18 23 20 21 20 21 21 20 21 20 23 18 23 18 21 17 21 17 20 15 20 15 18 17 18 17 17 18 17 18 15 20 15 20 17 21 17 21 18 23 18"
          ></polygon><polygon
            points="23 4 23 6 21 6 21 7 20 7 20 9 18 9 18 7 17 7 17 6 15 6 15 4 17 4 17 3 18 3 18 1 20 1 20 3 21 3 21 4 23 4"
          ></polygon><polygon
            points="17 11 17 13 15 13 15 14 13 14 13 15 12 15 12 16 11 16 11 18 10 18 10 20 8 20 8 18 7 18 7 16 6 16 6 15 5 15 5 14 3 14 3 13 1 13 1 11 3 11 3 10 5 10 5 9 6 9 6 8 7 8 7 6 8 6 8 4 10 4 10 6 11 6 11 8 12 8 12 9 13 9 13 10 15 10 15 11 17 11"
          ></polygon>
        </svg>
        <h2
          class="max-w-[32rem] font-pixel-hackers text-4xl md:text-6xl leading-relaxed pb-6 pt-6"
        >
          The Show
        </h2>
        <p class="max-w-[32rem] font-polysans text-l leading-relaxed">
          At the end of the year, we hold the Show, an exhibit where our
          community comes together to share projects made throughout the
          semester at Hack Night and beyond.
        </p>
        <br />
        <p class="font-inconsolata text-xl font-semibold uppercase">
          ???????: Fall 2026
        </p>
        <a
          href="https://spill.purduehackers.com/"
          target="_blank"
          class="font-inconsolata text-xl font-semibold uppercase underline hover:text-[var(--color-secondary)] transition-colors duration-300 motion-reduce:transition-none"
          >spill ≋: Fall 2025</a
        >
        <br />
        <a
          href="https://burst.purduehackers.com/"
          target="_blank"
          class="font-inconsolata text-xl font-semibold uppercase underline hover:text-[var(--color-secondary)] transition-colors duration-300 motion-reduce:transition-none"
          >BURST ✷: Fall 2024</a
        >
        <p class="pt-6">
          <a
            href="/shows"
            class="font-inconsolata text-l md:text-xl font-semibold uppercase underline hover:text-[var(--color-secondary)] transition-colors duration-300 motion-reduce:transition-none"
            >All the shows →</a
          >
        </p>
      </div>
      <div class="mb-72 relative w-full max-w-2xl">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="w-8 h-8 mx-auto text-[var(--color-secondary)]"
          fill="currentColor"
        >
          <polygon
            points="23 6 23 11 22 11 22 12 21 12 21 13 20 13 20 14 19 14 19 15 18 15 18 16 17 16 17 17 16 17 16 18 15 18 15 19 14 19 14 20 13 20 13 21 11 21 11 20 10 20 10 19 9 19 9 18 8 18 8 17 7 17 7 16 6 16 6 15 5 15 5 14 4 14 4 13 3 13 3 12 2 12 2 11 1 11 1 6 2 6 2 5 3 5 3 4 4 4 4 3 10 3 10 4 11 4 11 5 13 5 13 4 14 4 14 3 20 3 20 4 21 4 21 5 22 5 22 6 23 6"
          ></polygon></svg
        >
        <h2
          class="max-w-[32rem] mx-auto text-center font-pixel-hackers text-4xl md:text-6xl leading-relaxed pb-6 pt-6"
        >
          Friends
        </h2>
        <p
          class="max-w-[32rem] font-polysans text-l mx-auto text-center leading-relaxed pb-8"
        >
          We're working to make Purdue one of the best places in the world to be
          a <span class="highlight">young and ambitious builder</span> &mdash; and
          we're lucky to be backed by people and companies whose work we really admire.
        </p>
        <p
          class="font-inconsolata text-l md:text-xl font-semibold uppercase mx-auto text-center mb-8 md:mb-12"
        >
          <a
            href="https://www.paulgraham.com/"
            target="_blank"
            class="font-inconsolata text-l md:text-xl font-semibold uppercase underline hover:text-[var(--color-secondary)] transition-colors duration-300 motion-reduce:transition-none"
            >paul graham</a
          >
          *
          <a
            href="https://mitchellh.com/"
            target="_blank"
            class="font-inconsolata text-l md:text-xl font-semibold uppercase underline hover:text-[var(--color-secondary)] transition-colors duration-300 motion-reduce:transition-none"
            >mitchell hashimoto</a
          >
        </p>
        <LogoGrid logos={sponsorLogos} showGrid={false} />
        <p
          class="max-w-[32rem] font-polysans text-l mx-auto text-center leading-relaxed pt-16 md:pt-24 pb-6"
        >
          Want to help us keep making?
        </p>
        <a
          href="https://hcb.hackclub.com/donations/start/purdue-hackers"
          target="_blank"
          class="join-session-btn"
          style="background: var(--color-bg); --pixel-cols: 6; --pixel-color: var(--color-bg); --pixel-color-hover: var(--color-secondary); --label-color: black;"
        >
          <span class="join-session-btn__pixels" aria-hidden="true">
            {
              backPixels.map((delayIndex) => (
                <span
                  class="join-session-btn__pixel"
                  style={`--i: ${delayIndex}`}
                />
              ))
            }
          </span>
          <span class="join-session-btn__label pointer-events-none"
            >back us</span
          >
        </a>
        <p class="pt-6">
          <a
            href="/support"
            class="font-inconsolata text-l md:text-xl font-semibold uppercase underline hover:text-[var(--color-secondary)] transition-colors duration-300 motion-reduce:transition-none"
            >Microgrants + ways to support →</a
          >
        </p>
      </div>
    </section>
  </main>
  <script>
    function initPhotoCaption() {
      const tip = document.getElementById(
        'photo-caption'
      ) as HTMLElement | null;
      if (!tip) return;

      const isMobile = window.matchMedia('(max-width: 768px)').matches;
      if (isMobile) return;

      const titleEl = tip.querySelector('.photo-caption__title') as HTMLElement;
      const descEl = tip.querySelector('.photo-caption__desc') as HTMLElement;
      const desktopCollage = document.querySelector('.photo-collage--desktop');
      if (!desktopCollage) return;
      const images = desktopCollage.querySelectorAll('[data-caption-title]');

      let active = false;

      function show(img: Element, e: MouseEvent) {
        const title = img.getAttribute('data-caption-title') || '';
        const desc = img.getAttribute('data-caption-desc') || '';
        titleEl.textContent = title;
        descEl.textContent = desc;
        active = true;
        positionTooltip(e);
        tip!.classList.add('is-visible');
      }

      function hide() {
        active = false;
        tip!.classList.remove('is-visible');
      }

      function positionTooltip(e: MouseEvent) {
        const offset = 16;
        let x = e.clientX + offset;
        let y = e.clientY + offset;
        const rect = tip!.getBoundingClientRect();
        if (x + rect.width > window.innerWidth - 8) {
          x = e.clientX - rect.width - offset;
        }
        if (y + rect.height > window.innerHeight - 8) {
          y = e.clientY - rect.height - offset;
        }
        tip!.style.left = x + 'px';
        tip!.style.top = y + 'px';
      }

      images.forEach((img) => {
        img.addEventListener('mouseenter', (e) => show(img, e as MouseEvent));
        img.addEventListener('mousemove', (e) => {
          if (active) positionTooltip(e as MouseEvent);
        });
        img.addEventListener('mouseleave', hide);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPhotoCaption);
    } else {
      initPhotoCaption();
    }
  </script>
  <script>
    import { initPixelTrail } from '../scripts/pixelTrail';
    import { getCollageDarkAnchor } from '../utils/collageAnchor';

    function initCursorTrail() {
      const container = document.getElementById('pixel-trail-container');
      if (!container) return;

      const desktop = window.matchMedia('(min-width: 768px)');
      const reducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      );
      let trail: ReturnType<typeof initPixelTrail> | null = null;

      // trail turns yellow once the dark collage section reaches mid-viewport
      function currentColor() {
        const darkEl = getCollageDarkAnchor();
        if (!darkEl) return '#000000';
        const rect = darkEl.getBoundingClientRect();
        return rect.top <= window.innerHeight * 0.5 ? '#FFEE00' : '#000000';
      }

      function updateColor() {
        trail?.setColor(currentColor());
      }

      function sync() {
        const wanted = desktop.matches && !reducedMotion.matches;
        if (wanted && !trail) {
          trail = initPixelTrail(container!, {
            gridSize: 85,
            trailSize: 0.05,
            maxAge: 220,
            interpolate: 3,
            color: currentColor(),
          });
        } else if (!wanted && trail) {
          trail.destroy();
          trail = null;
        }
      }

      sync();
      desktop.addEventListener('change', sync);
      reducedMotion.addEventListener('change', sync);
      window.addEventListener('scroll', updateColor, { passive: true });
      window.addEventListener('resize', updateColor, { passive: true });

      document.addEventListener(
        'astro:before-swap',
        () => {
          trail?.destroy();
          trail = null;
          desktop.removeEventListener('change', sync);
          reducedMotion.removeEventListener('change', sync);
          window.removeEventListener('scroll', updateColor);
          window.removeEventListener('resize', updateColor);
        },
        { once: true }
      );
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCursorTrail);
    } else {
      initCursorTrail();
    }
  </script>
  <script>
    // Keep the hero grid in phase with the glider shader's cells. The glider
    // is positioned with percentage offsets + translates, so the cell origin
    // relative to the section is only known at layout time.
    function initHeroGrid() {
      const grid = document.querySelector('.hero-grid');
      const canvas = document.querySelector('canvas[data-glider-shader]');
      if (!(grid instanceof HTMLElement) || !(canvas instanceof HTMLElement)) {
        return;
      }

      const cell = parseInt(canvas.dataset.cellSize || '10');
      grid.style.setProperty('--hero-grid-cell', `${cell}px`);

      const align = () => {
        const g = grid.getBoundingClientRect();
        const c = canvas.getBoundingClientRect();
        const dpr = window.devicePixelRatio || 1;
        const phase = (v: number) =>
          Math.round((((v % cell) + cell) % cell) * dpr) / dpr;
        grid.style.backgroundPosition = `${phase(c.left - g.left)}px ${phase(c.top - g.top)}px`;
      };

      let raf = 0;
      const queueAlign = () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(align);
      };

      align();
      // canvas gets its real size once the shader boots; section height moves
      // as fonts/images settle — observe both instead of guessing timing
      const ro = new ResizeObserver(queueAlign);
      ro.observe(grid);
      ro.observe(canvas);
      window.addEventListener('resize', queueAlign);
      document.fonts?.ready.then(queueAlign);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroGrid);
    } else {
      initHeroGrid();
    }
  </script>
  <script>
    import { initPhotoCollageParallax } from '../scripts/photoCollageParallax';

    const stopParallax = initPhotoCollageParallax();
    document.addEventListener(
      'astro:before-swap',
      () => {
        stopParallax();
      },
      { once: true }
    );
  </script>
</BaseLayout>
