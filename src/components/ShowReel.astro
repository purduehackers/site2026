---
import { getImage } from 'astro:assets';
import { shows } from '../data/shows';
import { getPixelIndices } from '../utils/dither';
import { IMAGE_QUALITY, photoWidths } from '../lib/images';
import { measureShowReel } from '../utils/showReelLayout';

const backgrounds = await Promise.all(
  shows.map((show) =>
    getImage({
      src: show.image,
      width: Math.min(1280, show.image.width),
      widths: photoWidths(Math.min(2560, show.image.width)),
      quality: IMAGE_QUALITY,
    })
  )
);
// Cover a full-height stage, including the source pixels cropped on phones.
const backgroundSizes = shows.map(
  (show) => `max(100vw, ${(100 * show.image.width) / show.image.height}svh)`
);
const initializeLayout = `(${measureShowReel.toString()})(document.currentScript.previousElementSibling);`;

// Match the hero photos: 8 × 6 tiles, randomized 8ms delays, 220ms fades.
const columns = 8;
const rows = 6;
const delays = getPixelIndices(columns * rows);
const revealDuration = (columns * rows - 1) * 8 + 220;
// Local gradient masks avoid WebKit's stale painting of referenced SVG masks.
const maskImages = delays
  .map((delay) => {
    const alpha = `clamp(0, calc((var(--show-reveal) * ${revealDuration} - ${delay * 8}) / 220), 1)`;
    return `linear-gradient(rgb(255 255 255 / ${alpha}) 0 0)`;
  })
  .join(',');
const maskPositions = delays
  .map(
    (_, tile) =>
      `${((tile % columns) / (columns - 1)) * 100}% ${(Math.floor(tile / columns) / (rows - 1)) * 100}%`
  )
  .join(',');
---

<section
  id="the-show"
  class="show-reel"
  data-show={shows[0].id}
  aria-labelledby="show-heading"
  style={`--show-count: ${shows.length}; --show-accent: ${shows[0].color};`}
>
  <div class="show-reel__stage">
    <div class="show-reel__backdrops" aria-hidden="true">
      <img
        class="show-reel__fallback"
        src={backgrounds[0].src}
        srcset={backgrounds[0].srcSet.attribute}
        sizes={backgroundSizes[0]}
        width={shows[0].image.width}
        height={shows[0].image.height}
        alt=""
        loading="lazy"
        decoding="async"
      />
      {
        shows.map((show, index) => (
          <div
            class="show-reel__scene"
            data-show-scene={show.id}
            style={`--show-mask: ${maskImages}; mask-position: ${maskPositions}; mask-size: calc(${100 / columns}% + 0.1px) calc(${100 / rows}% + 0.1px); --show-reveal-duration: ${revealDuration}ms;`}
          >
            <img
              class="show-reel__photo"
              data-src={backgrounds[index].src}
              data-srcset={backgrounds[index].srcSet.attribute}
              data-sizes={backgroundSizes[index]}
              width={show.image.width}
              height={show.image.height}
              alt=""
              decoding="async"
              style={`object-position: ${show.imagePosition ?? 'center'};`}
            />
            {show.id === 'waveforum' && (
              <canvas class="show-reel__shader" data-waveforum />
            )}
          </div>
        ))
      }
    </div>
    <div class="show-reel__shade" aria-hidden="true"></div>

    <div class="show-reel__content">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        class="show-reel__icon w-8 h-8 mx-auto"
        fill="currentColor"
        aria-hidden="true"
      >
        <polygon
          points="23 18 23 20 21 20 21 21 20 21 20 23 18 23 18 21 17 21 17 20 15 20 15 18 17 18 17 17 18 17 18 15 20 15 20 17 21 17 21 18 23 18"
        ></polygon><polygon
          points="23 4 23 6 21 6 21 7 20 7 20 9 18 9 18 7 17 7 17 6 15 6 15 4 17 4 17 3 18 3 18 1 20 1 20 3 21 3 21 4 23 4"
        ></polygon><polygon
          points="17 11 17 13 15 13 15 14 13 14 13 15 12 15 12 16 11 16 11 18 10 18 10 20 8 20 8 18 7 18 7 16 6 16 6 15 5 15 5 14 3 14 3 13 1 13 1 11 3 11 3 10 5 10 5 9 6 9 6 8 7 8 7 6 8 6 8 4 10 4 10 6 11 6 11 8 12 8 12 9 13 9 13 10 15 10 15 11 17 11"
        ></polygon>
      </svg>
      <h2
        id="show-heading"
        class="font-pixel-hackers text-4xl md:text-6xl leading-relaxed pb-6 pt-6"
      >
        The Show
      </h2>
      <p class="font-polysans text-l leading-relaxed">
        At the end of the year, we hold the Show, an exhibit where our community
        comes together to share projects made throughout the semester at Hack
        Night and beyond.
      </p>
      <ul class="show-reel__list">
        {
          shows.map((show) => (
            <li>
              <a
                class="show-reel__link font-inconsolata text-xl font-semibold uppercase"
                href={show.href}
                target="_blank"
                rel="noopener noreferrer"
                data-show-link={show.id}
                data-active={show === shows[0] ? '' : undefined}
                data-color={show.color}
                style={`--show-color: ${show.color};`}
              >
                {show.name}: {show.season}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
<script is:inline set:html={initializeLayout} />

<script>
  import { initShowReel } from '../scripts/showReel';
  const reel = document.querySelector<HTMLElement>('.show-reel');
  if (reel) {
    const cleanup = initShowReel(reel);
    document.addEventListener('astro:before-swap', cleanup, { once: true });
    if (import.meta.hot) import.meta.hot.dispose(cleanup);
  }
</script>

<style>
  @property --show-reveal {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }

  .show-reel {
    position: relative;
    width: calc(100% + 4rem);
    margin: 0 -2rem 18rem;
    color: var(--color-bg);
    text-align: center;
  }

  .show-reel__stage {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 6rem 2rem;
    overflow: clip;
    background: #000;
  }

  .show-reel[data-pinned] {
    height: calc(100svh + var(--show-count) * 80svh);
  }

  .show-reel[data-pinned] .show-reel__stage {
    position: sticky;
    top: 0;
    height: 100svh;
  }

  .show-reel__backdrops,
  .show-reel__scene,
  .show-reel__photo,
  .show-reel__shader,
  .show-reel__fallback,
  .show-reel__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .show-reel__backdrops {
    z-index: -2;
  }

  .show-reel__fallback,
  .show-reel__photo {
    object-fit: cover;
  }

  .show-reel__shader {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    animation: waveforum-hue 60s linear infinite;
    animation-play-state: paused;
  }

  .show-reel__shader[data-ready] {
    opacity: 1;
  }

  .show-reel__shader[data-running] {
    animation-play-state: running;
  }

  @keyframes waveforum-hue {
    to {
      filter: hue-rotate(360deg);
    }
  }

  .show-reel[data-image-ready] .show-reel__fallback {
    display: none;
  }

  .show-reel__scene {
    --show-reveal: 0;
    mask-image: var(--show-mask);
    mask-repeat: no-repeat;
    visibility: hidden;
    transition:
      --show-reveal var(--show-reveal-duration) linear,
      visibility 0s 620ms;
  }

  .show-reel__scene[data-active] {
    --show-reveal: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .show-reel__scene[data-revealed] {
    mask-image: none;
  }

  .show-reel__shade {
    z-index: -1;
    transition: opacity 220ms ease-out;
    background:
      linear-gradient(
        0deg,
        #000 0%,
        transparent 22%,
        transparent 78%,
        #000 100%
      ),
      radial-gradient(ellipse at center, #000b 0%, #0006 60%, #0003 100%);
  }

  .show-reel[data-show='waveforum'] .show-reel__shade {
    opacity: 0.4;
  }

  .show-reel__content {
    width: 100%;
    max-width: 32rem;
    text-shadow: 0 2px 16px #000;
  }

  .show-reel__icon {
    color: var(--show-accent);
    transition: color 220ms ease-out;
  }

  .show-reel__list {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    margin-top: 1.5rem;
  }

  .show-reel__link {
    display: inline-block;
    position: relative;
    padding: 0.5rem 0.75rem;
    color: #fffbf1b3;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transition: color 220ms ease-out;
  }

  .show-reel__link[data-active],
  .show-reel__link:hover,
  .show-reel__link:focus-visible {
    color: var(--show-color);
  }

  .show-reel a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .show-reel__scene,
    .show-reel__link,
    .show-reel__shade,
    .show-reel__icon {
      transition: none;
    }

    .show-reel__shader {
      animation: none;
    }
  }
</style>
