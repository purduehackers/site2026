---
import DiscordMessage from './DiscordMessage.astro';
import {
  DEFAULT_AVATAR_URL,
  DEFAULT_USERNAME_COLOR,
  type LatestShip,
} from '../lib/ships';

interface Props {
  ship?: LatestShip | null;
}

const { ship } = Astro.props;

const shipUser = ship?.username ?? 'Ray';
const shipTime = ship?.timeAgo ?? '3d ago';
const shipAvatar = ship?.avatarUrl ?? DEFAULT_AVATAR_URL;
const shipColor = ship?.usernameColor ?? DEFAULT_USERNAME_COLOR;
const shipImage = ship?.image ?? null;
const shipBodyHtml =
  ship?.contentHtml ??
  '<p>Shipped privacy options for Purdue Hackers — opt out of data collection like in Commit Overflow. Change settings with /privacy.</p>';
---

<DiscordMessage
  username={shipUser}
  usernameColor={shipColor}
  avatarUrl={shipAvatar}
  timeLabel={shipTime}
  contentHtml={shipBodyHtml}
  image={shipImage}
/>
