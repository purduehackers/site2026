---
import DiscordMessage from './DiscordMessage.astro';
import { communityMessages } from '../data/communityMessages';
import type { CommunityMessage } from '../lib/communityFeed';
import { renderShipContent } from '../lib/ships';

interface Props {
  messages?: CommunityMessage[];
}

const { messages = communityMessages } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'America/Indiana/Indianapolis',
});
const rendered = await Promise.all(
  messages.map(async (message) => ({
    ...message,
    contentHtml: await renderShipContent(message.content, 100),
  }))
);
---

<ul
  class="community-messages"
  data-community-messages
  aria-label="Posts from #ship"
>
  {
    rendered.map((message) => (
      <li>
        <a
          class="community-message photo-collage__card photo-collage__card--ships"
          href={message.sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <DiscordMessage
            channel={message.channel}
            username={message.username}
            usernameColor={message.usernameColor}
            avatarUrl={message.avatarUrl}
            timestamp={message.timestamp}
            timeLabel={dateFormatter.format(new Date(message.timestamp))}
            contentHtml={message.contentHtml}
            images={message.images}
            reactions={message.reactions}
          />
          <span class="sr-only">Open message in Discord (new tab)</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .community-messages {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .community-messages li {
    min-width: 0;
  }

  .community-message {
    border: 1px solid #484b51;
    border-radius: 8px;
    box-shadow: 0 10px 30px #0003;
  }

  .community-message:hover {
    border-color: #949ba4;
  }

  .community-message:focus-visible {
    outline: 3px solid var(--color-secondary);
    outline-offset: 4px;
  }

  .community-message :global(.ship-message__head) {
    flex-wrap: wrap;
    gap: 0.15rem 0.5rem;
  }

  .community-message :global(.ship-message__body) {
    max-height: none;
    overflow: visible;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  @media (min-width: 64rem) {
    .community-messages > li:nth-child(3n + 1) {
      margin-right: 1.5rem;
      transform: rotate(-1deg);
    }

    .community-messages > li:nth-child(3n + 2) {
      margin-left: 1.5rem;
      transform: rotate(1deg);
    }

    .community-messages > li:nth-child(3n) {
      margin-right: 1rem;
      transform: rotate(-0.5deg);
    }
  }
</style>
