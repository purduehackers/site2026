---
import { DITHER_BAND_ROWS, GLIDER_CELL_SIZE } from '../constants/gliderGrid';

interface Props {
  cellSize?: number;
  speedMs?: number;
  /** Rows of pinned dither at the bottom of the sim. */
  ditherRows?: number;
  class?: string;
}

const {
  cellSize = GLIDER_CELL_SIZE,
  speedMs = 100,
  ditherRows = DITHER_BAND_ROWS,
  class: className = '',
} = Astro.props;
---

<div
  class={`glider-wrap ${className}`.trim()}
  aria-hidden="true"
  data-cell-size={cellSize}
  data-speed-ms={speedMs}
  data-dither-rows={ditherRows}
>
  <canvas data-glider-shader></canvas>
</div>

<script>
  import { initGliderShader } from '../scripts/gliderShader';

  function init() {
    const canvases = document.querySelectorAll('canvas[data-glider-shader]');
    canvases.forEach((canvas) => {
      if (!(canvas instanceof HTMLCanvasElement)) return;
      if (canvas.dataset.initialized) return; // prevent double-init
      const wrap = canvas.parentElement;
      if (!wrap) return;

      canvas.dataset.initialized = 'true';

      // Config rides on the wrapper: the canvas sizes itself from that box.
      const cellSize = parseInt(wrap.dataset.cellSize || '10', 10);
      const speedMs = parseInt(wrap.dataset.speedMs || '100', 10);
      const ditherRows = parseInt(wrap.dataset.ditherRows || '22', 10);
      canvas.dataset.cellSize = String(cellSize);

      const cleanup = initGliderShader(canvas, {
        cellSize,
        speedMs,
        ditherRows,
        cellColor: [0, 0, 0],
      });

      // Astro view transitions safety
      document.addEventListener('astro:before-swap', cleanup, { once: true });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  /* Full-bleed layer: the sim covers the hero, and its last rows are the
     dithered transition into the dark section below. */
  .glider-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .glider-wrap canvas {
    position: absolute;
    /* whole cells only, so the solid rows sit flush on the section's edge */
    bottom: 0;
    left: 0;
    display: block;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }
</style>
