---
import { getImage } from 'astro:assets';
import { canOptimizeRemoteImage, IMAGE_QUALITY } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  widths: number[];
  sizes: string;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  widths,
  sizes,
  class: className,
} = Astro.props;
const optimized = canOptimizeRemoteImage(src)
  ? await getImage({
      src,
      width: width ?? widths[widths.length - 1],
      height,
      widths,
      quality: IMAGE_QUALITY,
    })
  : null;
---

<img
  class={className}
  src={optimized?.src ?? src}
  srcset={optimized?.srcSet.attribute || undefined}
  sizes={optimized ? sizes : undefined}
  width={width}
  height={height}
  alt={alt}
  loading="lazy"
  decoding="async"
/>
