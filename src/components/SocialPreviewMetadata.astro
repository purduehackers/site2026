---
import thumbnailImage from '../assets/thumbnail.png';

export interface Props {
  title: string;
  description: string;
  /** Canonical URL of the page. */
  url?: string;
}

const { title, description, url = Astro.url.href } = Astro.props;
// Crawlers need an absolute image URL.
const imageUrl = new URL(thumbnailImage.src, url).href;

const imageMimeType =
  thumbnailImage.format === 'png'
    ? 'image/png'
    : (() => {
        throw new Error('Not yet supported image format for thumbnail image');
      })();
---

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={url} />
<meta property="og:image:url" content={imageUrl} />
<meta property="og:image:width" content={thumbnailImage.width.toString()} />
<meta property="og:image:height" content={thumbnailImage.height.toString()} />
<meta property="og:image:type" content={imageMimeType} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@purduehackers">
<meta name="twitter:creator" content="@purduehackers">
{/* The title/description/image will fall back to the OpenGraph tags. */}
